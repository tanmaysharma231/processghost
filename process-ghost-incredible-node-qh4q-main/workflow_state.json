{
  "app_name": "ProcessGhost",
  "description": "AI Process Documentation Generator with 6 sequential agents and conditional judge loop",
  "agents": {
    "transcription_agent": {
      "agent_id": "69ec5b0720c378a25b45e8d2",
      "name": "Transcription Agent",
      "provider": "Google",
      "model": "gemini-2.5-pro",
      "temperature": 0.2,
      "top_p": 1,
      "response_schema_file": "response_schemas/transcription_agent_response.json"
    },
    "extraction_agent": {
      "agent_id": "69ec5b33603f5bad913c0dbd",
      "name": "Process Extraction Agent",
      "provider": "Anthropic",
      "model": "claude-sonnet-4-6",
      "temperature": 0.3,
      "top_p": 1,
      "response_schema_file": "response_schemas/process_extraction_agent_response.json"
    },
    "gap_detection_agent": {
      "agent_id": "69ec5b3307db2da1f5e0c20c",
      "name": "Gap Detection Agent",
      "provider": "Anthropic",
      "model": "claude-sonnet-4-6",
      "temperature": 0.3,
      "top_p": 1,
      "response_schema_file": "response_schemas/gap_detection_agent_response.json"
    },
    "visual_gap_filler_agent": {
      "agent_id": "69ec5b349291081b210b36ea",
      "name": "Visual Gap Filler Agent",
      "provider": "Google",
      "model": "gemini-2.5-pro",
      "temperature": 0.3,
      "top_p": 1,
      "response_schema_file": "response_schemas/visual_gap_filler_agent_response.json"
    },
    "synthesis_agent": {
      "agent_id": "69ec5b5bf7d0c95f8d9bf0b8",
      "name": "Documentation Synthesis Agent",
      "provider": "OpenAI",
      "model": "gpt-4.1",
      "temperature": 0.4,
      "top_p": 0.95,
      "file_output": true,
      "response_schema_file": "response_schemas/documentation_synthesis_agent_response.json"
    },
    "judge_agent": {
      "agent_id": "69ec5b5b9291081b210b36f8",
      "name": "SOP Judge Agent",
      "provider": "Anthropic",
      "model": "claude-sonnet-4-6",
      "temperature": 0.2,
      "top_p": 1,
      "response_schema_file": "response_schemas/sop_judge_agent_response.json"
    }
  },
  "conditional_logic": {
    "judge_decision": {
      "condition_field": "result.verdict",
      "routes": {
        "GAPS_REMAINING": "gap_detection_agent",
        "APPROVED": "output_node"
      }
    }
  },
  "workflow_flow": [
    "input_node -> transcription_agent",
    "transcription_agent -> extraction_agent",
    "extraction_agent -> gap_detection_agent",
    "gap_detection_agent -> visual_gap_filler_agent",
    "visual_gap_filler_agent -> synthesis_agent",
    "synthesis_agent -> judge_agent",
    "judge_agent -> judge_decision",
    "judge_decision -> gap_detection_agent (GAPS_REMAINING)",
    "judge_decision -> output_node (APPROVED)"
  ]
}