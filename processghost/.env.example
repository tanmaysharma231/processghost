# Provider used is core/config.py: LLM_PROVIDER ("openai" by default). OPENAI_API_KEY is always
# required (Whisper transcription runs on OpenAI either way); ANTHROPIC_API_KEY is only needed if
# LLM_PROVIDER = "anthropic".

# OpenAI (default provider, and always used for transcription)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_TYPE=  # leave blank for public API
OPENAI_API_MODEL_GPT4O=gpt-4o
OPENAI_API_MODEL_VISION=gpt-4o-mini
OPENAI_API_MODEL_WHISPER=whisper-1

# Anthropic (optional provider -- set core/config.py LLM_PROVIDER = "anthropic" to use it)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Optional: comma-separated app admins for future auth
APP_ADMINS=
