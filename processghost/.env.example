# Provider used is core/config.py: LLM_PROVIDER ("sarvam" by default). Only the active provider's
# key is required at runtime -- both are listed here so switching providers is a one-line config
# change, not a re-setup.

# Sarvam AI (default provider) -- https://api.sarvam.ai
SARVAM_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI (alternate provider -- set core/config.py LLM_PROVIDER = "openai" to use this instead)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_TYPE=  # leave blank for public API
OPENAI_API_MODEL_GPT4O=gpt-4o
OPENAI_API_MODEL_VISION=gpt-4o-mini
OPENAI_API_MODEL_WHISPER=whisper-1

# Optional: comma-separated app admins for future auth
APP_ADMINS=
