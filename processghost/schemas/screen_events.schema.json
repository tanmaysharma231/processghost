{
  "$defs": {
    "Scene": {
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "t_start": {
          "title": "T Start",
          "type": "number"
        },
        "t_end": {
          "title": "T End",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "t_start",
        "t_end"
      ],
      "title": "Scene",
      "type": "object"
    },
    "ScreenEvent": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "t_start": {
          "title": "T Start",
          "type": "number"
        },
        "t_end": {
          "title": "T End",
          "type": "number"
        },
        "type": {
          "enum": [
            "local",
            "large_shift",
            "scene_cut"
          ],
          "title": "Type",
          "type": "string"
        },
        "changed_pct": {
          "title": "Changed Pct",
          "type": "number"
        },
        "coverage_pct": {
          "title": "Coverage Pct",
          "type": "number"
        },
        "bboxes": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Bboxes",
          "type": "array"
        },
        "before_frame": {
          "title": "Before Frame",
          "type": "string"
        },
        "after_frame": {
          "title": "After Frame",
          "type": "string"
        },
        "scene_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Label"
        },
        "transient": {
          "default": false,
          "title": "Transient",
          "type": "boolean"
        },
        "peak_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Frame"
        },
        "residual_bboxes": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Residual Bboxes",
          "type": "array"
        },
        "context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Id"
        }
      },
      "required": [
        "event_id",
        "t_start",
        "t_end",
        "type",
        "changed_pct",
        "coverage_pct",
        "before_frame",
        "after_frame"
      ],
      "title": "ScreenEvent",
      "type": "object"
    }
  },
  "properties": {
    "video": {
      "title": "Video",
      "type": "string"
    },
    "video_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video Sha"
    },
    "duration_s": {
      "title": "Duration S",
      "type": "number"
    },
    "width": {
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "params": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Params",
      "type": "object"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ScreenEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "edit_band": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edit Band"
    },
    "activity": {
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "title": "Activity",
      "type": "array"
    }
  },
  "required": [
    "video",
    "duration_s",
    "width",
    "height"
  ],
  "title": "ScreenTimeline",
  "type": "object"
}
